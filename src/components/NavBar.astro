---
import PublicationIcon from "@/icons/icon-publication.astro";
import { ui, getLang } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = ui[lang];

const links = [
  { label: t.nav.about,           href: "#about" },
  { label: t.nav.experience,      href: "#experience" },
  { label: t.nav.education,       href: "#education" },
  { label: t.nav.certifications,  href: "#certifications" },
  { label: t.nav.projects,        href: "#projects" },
  { label: t.nav.skills,          href: "#skills" },
];
---

<header>
  <nav>
    <ul>
      {links.map(({ label, href }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>

    <a href={t.misc.switchLangHref} class="lang-btn">{t.misc.switchLangLabel}</a>

    <a href="/blog" class="pub-btn" title={t.nav.publications}>
      <PublicationIcon />
      <span>{t.nav.publications}</span>
    </a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #f0f0f0;
  }

  nav {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-size: 0.75rem;
    color: #555;
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  ul a:hover {
    background: #f2f2f2;
    color: #111;
  }

  .pub-btn,
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #555;
    border: 1px solid #e8e8e8;
    border-radius: 6px;
    padding: 4px 10px;
    white-space: nowrap;
  }

  .lang-btn:hover,
  .pub-btn:hover {
    background: #f2f2f2;
    color: #111;
  }


  .pub-btn :global(svg) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  @media (width <= 768px) {
    ul {
      display: none;
    }

    nav {
      padding: 0 1rem;
    }
  }
</style>
