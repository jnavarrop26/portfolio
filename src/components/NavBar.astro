---
import PublicationIcon from "@/icons/icon-publication.astro";

const links = [
  { label: "Sobre mí",      href: "#about" },
  { label: "Experiencia",   href: "#experience" },
  { label: "Educación",        href: "#education" },
  { label: "Certificaciones", href: "#certifications" },
  { label: "Proyectos",        href: "#projects" },
  { label: "Habilidades",   href: "#skills" },
];
---

<header>
  <nav>
    <ul>
      {links.map(({ label, href }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>

    <a href="/blog" class="pub-btn" title="Publicaciones">
      <PublicationIcon />
      <span>Publicaciones</span>
    </a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #f0f0f0;
  }

  nav {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  ul {
    margin-right: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    font-size: 0.75rem;
    color: #555;
    padding: 4px 8px;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  ul a:hover {
    background: #f2f2f2;
    color: #111;
  }

  .pub-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #555;
    border: 1px solid #e8e8e8;
    border-radius: 6px;
    padding: 4px 10px;
    white-space: nowrap;
  }


  .pub-btn :global(svg) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  @media (width <= 768px) {
    ul {
      display: none;
    }

    nav {
      padding: 0 1rem;
    }
  }
</style>
