---
import Section from "../Section.astro";
import { skills } from "cv.json";
---

<Section title="Habilidades">
  <ul>
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    background: #414652;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 20px;
  }
</style>
