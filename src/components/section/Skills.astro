---
import Section from "../Section.astro";
import { skills as skillsEs } from "cv.json";
import cvEn from "@/data/cv.en.json";
import { ui, getLang } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const skills = lang === "en" ? cvEn.skills : skillsEs;
const t = ui[lang];
---

<Section title={t.section.skills}>
  <ul>
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    background: #414652;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 20px;
  }
</style>
