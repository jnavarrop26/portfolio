---
import { basics as basicsEs } from "cv.json";
import cvEn from "@/data/cv.en.json";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import WorldMap from "@/icons/WorldMap.astro";
import PublicationIcon from "@/icons/icon-publication.astro";
import Section from "@/components/Section.astro";
import { ui, getLang } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const basics = lang === "en" ? cvEn.basics : basicsEs;
const t = ui[lang];
const { name, label, image, profiles, location, phone, email } = basics;
const { city, region } = location;
const labelLines = label.split(" - ");

const SOCIAL_ICONS: Record<string, any> = {
  GitHub,
  LinkedIn,
  X,
};

const printInfo = [
  email,
  phone,
  ...profiles.map(({ network, url }) => `${network}: ${url}`),
].filter(Boolean)
---

<Section>
  <div class="container">
    <div class="info">
      <h1>{name}</h1>
      <div class="label-stack">
        {labelLines.map((line) => <span>{line}</span>)}
      </div>
      <span>
        <WorldMap />
        {city}, {region}
      </span>
      <footer class="print">
        {printInfo.map((item) => <span>{item}</span>)}
      </footer>
      <footer class="no-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={t.fmt.emailTitle(name, email)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={t.fmt.phoneTitle(name, phone)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network]

            return (
              <a
                href={url}
                title={t.fmt.profileTitle(name, network)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            )
          })
        }
        <a href="/blog" title={t.misc.viewPublications} class="pub-link">
          <PublicationIcon />
        </a>
      </footer>
    </div>
    <figure>
      <img src={image} alt={name} />
    </figure>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2rem;
  }

  .label-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .label-stack span {
    color: #444;
    font-weight: 500;
    font-size: 0.9rem;
    font-family: system-ui, sans-serif;
  }

  h2 {
    color: #444;
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    border-radius: 16px;
  }

  span {
    color: #666;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: #555;
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer.print {
    flex-wrap: wrap;
  }

  footer.print span:not(:last-child)::after {
    content: " • ";
  }

  footer a {
    color: #777;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #eee;
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  footer a:hover {
    background: #eee;
    border: 1px solid #ddd;
  }

  .pub-link {
    width: 32px !important;
    height: 32px !important;
    padding: 4px !important;
  }

  .pub-link :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    .label-stack {
      align-items: center;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    h2 {
      text-wrap: balance;
    }

    figure {
      margin: 0 auto;
    }
  }
</style>
