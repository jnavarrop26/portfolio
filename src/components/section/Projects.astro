---
import GitHub from "@/icons/GitHub.astro";
import Section from "../Section.astro";
import { projects as projectsEs } from "cv.json";
import cvEn from "@/data/cv.en.json";
import { ui, getLang } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const projects = lang === "en" ? cvEn.projects : projectsEs;
const t = ui[lang];
const localePrefix = lang === "en" ? "/en" : "";
---

<Section title={t.section.projects}>
  <ul>
    {
      projects.map(
        ({ url, description, highlights, name, isActive, github, caseStudyUrl }, index) => {
          const featured = index === 0;
          return (
            <li class:list={[{ featured }]}>
              <article>
                <header>
                  <div class="title-row">
                    <h3>
                      {url
                        ? <a href={url} target="_blank" title={t.fmt.viewProjectTitle(name)}>{name}</a>
                        : <span>{name}</span>
                      }
                    </h3>
                    {featured && <span class="badge-featured">{t.misc.featured}</span>}
                    {github && (
                      <a class="github-code-link" href={github} target="_blank" title={t.misc.viewSourceCode}>
                        <GitHub />
                        {isActive && <span class="active-symbol">&bull;</span>}
                      </a>
                    )}
                  </div>
                  <p>{description}</p>
                  {caseStudyUrl && (
                    <a class="case-study-link" href={`${localePrefix}${caseStudyUrl}`}>
                      {t.misc.viewCaseStudy} →
                    </a>
                  )}
                </header>
                <footer>
                  {highlights.map((highlight) => <span>{highlight}</span>)}
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-inline: -16px;
  }

  article {
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
  }

  article header {
    flex: 1;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .badge-featured {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #111;
    color: #fff;
    padding: 2px 8px;
    border-radius: 20px;
  }

  li.featured article h3 span,
  li.featured article h3 a {
    color: #000;
    font-weight: 700;
  }

  li.featured article {
    border-color: #ddd;
    background: #fafafa;
  }

  article h3 {
    margin: 0;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.2rem;
    margin-bottom: 4px;
  }

  .case-study-link {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: #111;
    margin-bottom: 8px;
  }

  .case-study-link:hover {
    text-decoration: underline;
  }

  .active-symbol {
    color: rgb(0, 188, 47);
    animation-name: flicker;
    animation-duration: 3s;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    margin-top: 4px;
  }

  footer span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eaeaea;
    color: #333;
    font-size: 0.68rem;
    font-weight: 700;
    text-align: center;
    padding: 2px 8px;
    border-radius: 20px;
  }

  .github-code-link {
    margin-left: 5px;
  }

  @keyframes flicker {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
    100% {
      opacity: 1;
    }
  }

  @media (width <= 700px) {
    ul {
      grid-template-columns: 1fr;
      margin-inline: 0px;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px #f2f2f2;
      padding: 0 0 16px 0;
    }
  }

  @media print {
    article h3 span {
      animation-name: none;
    }
  }
</style>
