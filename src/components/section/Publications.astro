---
import Section from "../Section.astro";
import PublicationIcon from "@/icons/icon-publication.astro";
import { publications } from "cv.json";

const typeLabel: Record<string, string> = {
  article: "Artículo",
  paper: "Paper",
};
---

<Section title="Publicaciones">
  <ul>
    {
      publications.map(({ name, type, publisher, releaseDate, url, summary, tags }) => {
        const formattedDate = releaseDate
          ? new Date(releaseDate).toLocaleDateString("es-CO", {
              year: "numeric",
              month: "short",
            })
          : null;

        return (
          <li>
            <article>
              <header>
                <div class="pub-meta">
                  <span class={`pub-type pub-type--${type}`}>
                    <PublicationIcon />
                    {typeLabel[type] ?? type}
                  </span>
                  {formattedDate && (
                    <time datetime={releaseDate}>{formattedDate}</time>
                  )}
                </div>

                <h3>
                  {url ? (
                    <a href={url} target="_blank" rel="noopener noreferrer" title={`Leer: ${name}`}>
                      {name}
                    </a>
                  ) : (
                    <span>{name}</span>
                  )}
                </h3>

                {publisher && <p class="publisher">{publisher}</p>}
                <p class="summary">{summary}</p>
              </header>

              {tags && tags.length > 0 && (
                <footer>
                  {tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </footer>
              )}
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  article {
    border-radius: 8px;
    border: 1px solid #f2f2f2;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  article:hover {
    border-color: #ddd;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  article header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .pub-type {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 20px;
  }

  .pub-type--article {
    background: #e8f4fd;
    color: #1a73e8;
  }

  .pub-type--paper {
    background: #f0f4ff;
    color: #4f46e5;
  }

  time {
    font-size: 0.72rem;
    color: #888;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  h3 a {
    color: #111;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  h3 span {
    color: #111;
  }

  .publisher {
    font-size: 0.72rem;
    color: #666;
    font-style: italic;
    margin: 0;
  }

  .summary {
    font-size: 0.78rem;
    line-height: 1.5;
    color: #444;
    margin: 4px 0 0;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
  }

  footer span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: #eee;
    color: #444;
    font-size: 0.6rem;
    font-weight: 700;
    text-align: center;
    padding: 0.2rem 0.6rem;
  }

  @media (width <= 700px) {
    article {
      border: none;
      box-shadow: 0 1px 1px #f2f2f2;
      padding: 0 0 16px 0;
    }

    article:hover {
      box-shadow: 0 1px 1px #f2f2f2;
    }
  }
</style>
