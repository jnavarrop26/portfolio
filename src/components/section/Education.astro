---
import Section from "../Section.astro"
import { education as educationEs } from "cv.json"
import cvEn from "@/data/cv.en.json"
import { ui, getLang } from "@/i18n/ui"

const lang = getLang(Astro.currentLocale)
const education = lang === "en" ? cvEn.education : educationEs
const t = ui[lang]
---


<Section title={t.section.education}>
    <ul>
      {
        education.map(({ institution, startDate, endDate, area }) => {

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{institution} </h3>
                  </div>

                  <div class="date-container">
                    <time datetime={startDate} data-title={startDate}>
                    {startDate} {" - "}
                    </time>

                    <time datetime={endDate} data-title={endDate}>
                    {endDate}
                    </time>
                </div>
                </header>
  
                <footer>
                  <p>{area}</p>
                </footer>
              </article>
            </li>
          )
        })
      }
    </ul>
  </Section>

  <style>
    ul {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
  
    article h3 {
      font-weight: 500;
      color: #111;
    }
  
    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
    }
  
    time {
      color: #555;
      font-size: 0.85rem;
      min-width: 102px;
    }
  
    @media (width <= 700px) {
      time {
        text-align: right;
      }
    }
  </style>