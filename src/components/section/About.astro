---
import Section from "@/components/Section.astro";
import { basics as basicsEs } from "cv.json";
import basicsEnData from "@/data/cv.en.json";
import { ui, getLang } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const { summary } = lang === "en" ? basicsEnData.basics : basicsEs;
const t = ui[lang];
---


<Section title={t.section.about} >
    <p>
        {summary}
    </p>
</Section>
