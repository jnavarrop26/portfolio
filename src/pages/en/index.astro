---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/section/About.astro';
import Education from '@/components/section/Education.astro';
import Experience from '@/components/section/Experience.astro';
import Hero from '@/components/section/Hero.astro';
import Certifications from '@/components/section/Certifications.astro';
import Projects from '@/components/section/Projects.astro';
import Skills from '@/components/section/Skills.astro';
import KeyboardManager from '@/components/KeyboardManager.astro';
import NavBar from '@/components/NavBar.astro';
import cvEn from '@/data/cv.en.json';
import { ui, getLang } from '@/i18n/ui';
const { name, label } = cvEn.basics;
const t = ui[getLang(Astro.currentLocale)];
---

<Layout title={t.fmt.portfolioTitle(name, label)}>
	<NavBar />
	<main>
		<Hero />
		<div id="about">    <About />     </div>
		<div id="experience"><Experience /></div>
		<div id="education">       <Education />       </div>
		<div id="certifications">  <Certifications />  </div>
		<div id="projects">        <Projects />        </div>
		<div id="skills">    <Skills />    </div>
	</main>
	<KeyboardManager/>
</Layout>

<style>

main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (max-width: 700px) {
    main {
      padding: 1.5rem 1rem;
    }
  }


</style>
