---
import Layout from "@/layouts/Layout.astro";
import RecyOpsCaseStudy from "@/components/RecyOpsCaseStudy.astro";
import { recyops } from "@/data/recyops";

const data = recyops.en;
---

<Layout title={`${data.title} — Jose Navarro`}>
  <main>
    <a href="/en" class="back-link">{data.backLink}</a>
    <RecyOpsCaseStudy />
  </main>
</Layout>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #111;
  }

  @media (max-width: 700px) {
    main {
      padding: 2rem 1.25rem;
    }
  }
</style>
